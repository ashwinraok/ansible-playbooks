---
- name: apt update 
  apt:
    update_cache: yes
    
- name: Install Nginx
  apt:
    name: nginx 
    state: present 
    
- name: Enable Nginx
  service: 
    name : nginx
    enabled: yes 
    
- name: Start Nginx
  service: 
    name : nginx
    state: started

- name: Copy Nginx Index Page
  copy:
    src: index.nginx-debian.html
    dest: /var/www/html/index.nginx-debian.html
    mode: '0777'

- name: Restart Nginx
  service:
    name: nginx
    state: restarted 
    
    
